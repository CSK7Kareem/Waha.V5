                            IconButton(onClick = { onOpen(r) }) { Icon(Icons.Default.PlayArrow, null) }
                            IconButton(onClick = { Store.deleteRoutine(context, r.id); refresh++ }) { Icon(Icons.Default.Delete, null) }
                        }
                    }
                }
            }
        }
    }
}

@Composable
fun CreateRoutineScreen(onBack: () -> Unit, onSaved: () -> Unit) {
    val context = LocalContext.current
    var name by remember { mutableStateOf("") }
    var emoji by remember { mutableStateOf("🌴") }
    var slot by remember { mutableStateOf("any") }
    var oath by remember { mutableStateOf(true) }
    var timer by remember { mutableStateOf(true) }
    var lock by remember { mutableStateOf(false) }
    var stepText by remember { mutableStateOf("") }
    var stepSeconds by remember { mutableStateOf("60") }
    val steps = remember { mutableStateListOf<Step>() }
    val days = remember { mutableStateListOf(1, 2, 3, 4, 5, 6, 7) }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("منشئ روتين") },
                navigationIcon = { IconButton(onClick = onBack) { Icon(Icons.Default.ArrowBack, null) } }
            )
        }
    ) { pad ->
        LazyColumn(
            Modifier.fillMaxSize().padding(pad).padding(18.dp),
            verticalArrangement = Arrangement.spacedBy(12.dp)
        ) {
            item {
                OutlinedTextField(name, { name = it }, Modifier.fillMaxWidth(), label = { Text("اسم الروتين") })
            }
            item {
                OutlinedTextField(emoji, { emoji = it.take(2) }, Modifier.fillMaxWidth(), label = { Text("الرمز") })
            }
            item {
                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    listOf("morning" to "صباح", "night" to "ليل", "any" to "أي وقت").forEach { (v, label) ->
                        FilterChip(selected = slot == v, onClick = { slot = v }, label = { Text(label) })
                    }
                }
            }
            item { Text("الأيام") }
            item {
                Row(horizontalArrangement = Arrangement.spacedBy(5.dp)) {
                    (1..7).forEach { d ->
                        FilterChip(selected = days.contains(d), onClick = {
                            if (days.contains(d)) days.remove(d) else days.add(d)
                        }, label = { Text(dayShort(d)) })
                    }
                }
            }
            item {
                Divider()
                Text("إضافة خطوة", fontWeight = FontWeight.Bold)
            }
            item {
                OutlinedTextField(stepText, { stepText = it }, Modifier.fillMaxWidth(), label = { Text("نص الخطوة") })
            }
            item {
                OutlinedTextField(stepSeconds, { stepSeconds = it.filter(Char::isDigit) }, Modifier.fillMaxWidth(), label = { Text("المدة بالثواني") })
            }
            item {
                Button(
                    onClick = {
                        if (stepText.isNotBlank()) {
                            steps.add(Step(stepText.trim(), stepSeconds.toIntOrNull() ?: 0))
                            stepText = ""
                        }
                    },
                    modifier = Modifier.fillMaxWidth()
                ) { Text("إضافة الخطوة") }
            }
            items(steps) { s ->
                Text("• ${s.text} — ${s.seconds} ثانية")
            }
            item { ToggleRow("يلزم القَسَم", oath) { oath = it } }
            item { ToggleRow("المؤقّت إلزامي", timer) { timer = it } }
            item { ToggleRow("يقفل الجهاز عند الموعد", lock) { lock = it } }
            item {
                Button(
                    enabled = name.isNotBlank() && steps.isNotEmpty(),
                    onClick = {
                        Store.addRoutine(context, Routine(
                            System.currentTimeMillis(), name.trim(), emoji, slot, days.toSet(),
                            steps.toList(), oath, timer, lock
                        ))
                        AlarmScheduler.scheduleAll(context)
                        onSaved()
                    },
                    modifier = Modifier.fillMaxWidth()
                ) { Text("حفظ الروتين") }
            }
        }
    }
}

fun dayShort(d: Int): String = when (d) {
    Calendar.SUNDAY -> "أح"
    Calendar.MONDAY -> "ن"
    Calendar.TUESDAY -> "ث"
    Calendar.WEDNESDAY -> "ر"
    Calendar.THURSDAY -> "خ"
    Calendar.FRIDAY -> "ج"
    else -> "س"
}

@Composable
fun ToggleRow(label: String, value: Boolean, onChange: (Boolean) -> Unit) {
    Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.SpaceBetween) {
        Text(label)
        Switch(value, onChange)
    }
}

