fun awardName(xp: Int): String = when {
    xp >= 1500 -> "وسام سلطان الرمال"
    xp >= 300 -> "وسام 300 نقطة"
    else -> "لا يزال الطريق مستمرًا"
}

fun badges(c: Context): List<String> {
    val log = Store.log(c)
    val xp = Store.xp(c)
    val result = mutableListOf<String>()
    if (log.isNotEmpty()) result.add("أول إنجاز")
    if (longestStreak(log) >= 7) result.add("7 أيام")
    if (longestStreak(log) >= 30) result.add("30 يومًا")
    if (log.size >= 100) result.add("100 إنجاز")
    if (xp >= 300) result.add("300 نقطة")
    if (xp >= 1500) result.add("سلطان الرمال")
    return result
}

fun nextRankXp(xp: Int): Int = when {
    xp < 200 -> 200
    xp < 450 -> 450
    xp < 800 -> 800
    xp < 1500 -> 1500
    else -> 1500
}

fun rankProgress(xp: Int): Float {
    val previous = when {
        xp < 200 -> 0
        xp < 450 -> 200
        xp < 800 -> 450
        xp < 1500 -> 800
        else -> 1500
    }
    val next = nextRankXp(xp)
    return if (next == previous) 1f else ((xp - previous).toFloat() / (next - previous)).coerceIn(0f, 1f)
}

fun hasAccessibility(context: Context): Boolean {
    val manager = context.getSystemService(Context.ACCESSIBILITY_SERVICE) as android.view.accessibility.AccessibilityManager
    return manager.getEnabledAccessibilityServiceList(
        android.accessibilityservice.AccessibilityServiceInfo.FEEDBACK_ALL_MASK
    ).any { it.resolveInfo.serviceInfo.packageName == context.packageName }
}

fun hasNotificationPermission(context: Context): Boolean =
    Build.VERSION.SDK_INT < 33 ||
        ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) == PackageManager.PERMISSION_GRANTED

fun hasLocationPermission(context: Context): Boolean =
    ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED

fun canExactAlarm(context: Context): Boolean {
    val am = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
    return Build.VERSION.SDK_INT < 31 || am.canScheduleExactAlarms()
}

fun nextAlarmText(context: Context, slot: String): String =
    "${formatMinutes(Store.alarmHour(context, slot) * 60 + Store.alarmMinute(context, slot))} — ${slotLabel(slot)}"

fun normalizeTime(hour: Int, minute: Int): Int =
    (hour.coerceIn(0, 23) * 60 + minute.coerceIn(0, 59))

fun dateStamp(daysAgo: Int): String {
    val cal = Calendar.getInstance()
    cal.add(Calendar.DAY_OF_YEAR, -daysAgo)
    return SimpleDateFormat("yyyy-MM-dd", Locale.US).format(cal.time)
}

fun dailyCount(c: Context, daysAgo: Int): Int {
    val key = dateStamp(daysAgo)
    return Store.log(c).count { it.date == key }
}

fun weekCounts(c: Context): List<Int> = (6 downTo 0).map { dailyCount(c, it) }

fun totalXpFromLog(c: Context): Int = Store.log(c).sumOf { it.xp }

fun completionFor(c: Context, routineId: Long, daysAgo: Int): Boolean {
    val key = dateStamp(daysAgo)
    return Store.log(c).any { it.date == key && it.routineId == routineId }
}

fun clearEmergencyIfExpired(c: Context) {
    if (Store.emergencyUntil(c) < System.currentTimeMillis()) Store.setEmergencyUntil(c, 0)
}

fun isNight(c: Context): Boolean = inWindow(c, "night")

fun isMorning(c: Context): Boolean = inWindow(c, "morning")

fun describeMode(mode: String): String = when (mode) {
    "AUTO" -> "تلقائي"
    "MORNING" -> "صباح"
    "NIGHT" -> "ليل"
    "DAY" -> "نهار"
    else -> "تلقائي"
}

fun describeTheme(theme: String): String = when (theme) {
    "LIGHT" -> "فاتح رملي"
    "DARK" -> "داكن ليلي"
    "AUTO" -> "تلقائي"
    else -> "فاتح رملي"
}

fun routineSummary(r: Routine): String {
    val duration = r.steps.sumOf { it.seconds }
    val oath = if (r.oath) "مع قَسَم" else "بدون قَسَم"
    val timer = if (r.mandatoryTimer) "مؤقت إلزامي" else "مؤقت حر"
    return "${r.steps.size} خطوات • ${duration}ث • $oath • $timer"
}

fun shareAchievement(context: Context) {
    val text = "إنجازي في الواحة: ${Store.log(context).size} إنجاز و${Store.xp(context)} XP 🌴"
    val intent = Intent(Intent.ACTION_SEND).apply {
        type = "text/plain"
        putExtra(Intent.EXTRA_TEXT, text)
    }
    context.startActivity(Intent.createChooser(intent, "مشاركة"))
}

fun openAccessibility(context: Context) {
    context.startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
}

fun openNotificationSettings(context: Context) {
    context.startActivity(Intent(Settings.ACTION_APP_NOTIFICATION_SETTINGS).apply {
        putExtra(Settings.EXTRA_APP_PACKAGE, context.packageName)
    })
}

fun openExactAlarmSettings(context: Context) {
    if (Build.VERSION.SDK_INT >= 31) {
        context.startActivity(Intent(Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM).apply {
            data = android.net.Uri.parse("package:${context.packageName}")
        })
    }
}

fun openAppDetails(context: Context) {
    context.startActivity(Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply {
        data = android.net.Uri.parse("package:${context.packageName}")
    })
}

fun routineIdFromIntent(intent: Intent?): Long? =
    intent?.getLongExtra("routineId", -1L)?.takeIf { it > 0 }

fun chooseRoutineForLock(context: Context, intent: Intent?): Routine? {
    val id = routineIdFromIntent(intent)
    if (id != null) Store.routines(context).firstOrNull { it.id == id }?.let { return it }
    return dueLockedRoutine(context)
}

fun shouldShowLock(context: Context): Boolean =
    Store.isLockEnabled(context) &&
        Store.emergencyUntil(context) <= System.currentTimeMillis() &&
        dueLockedRoutine(context) != null

fun migrateLegacyData(context: Context) {
    if (!context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).contains(KEY_ROUTINES)) {
        Store.saveRoutines(context, defaultRoutines())
    }
}

fun initialize(context: Context) {
    migrateLegacyData(context)
    NotificationHelper.createChannel(context)
    AlarmScheduler.scheduleAll(context)
    clearEmergencyIfExpired(context)
}

fun validateRoutine(r: Routine): Boolean =
    r.name.isNotBlank() &&
        r.steps.isNotEmpty() &&
        r.steps.all { it.text.isNotBlank() && it.seconds >= 0 } &&
        r.days.isNotEmpty()

fun addCompletionWithBonus(context: Context, routine: Routine, bonus: Int) {
    val before = Store.log(context).size
    Store.complete(context, routine)
    if (Store.log(context).size > before && bonus > 0) Store.addXp(context, bonus)
}

fun currentGreeting(c: Context): String = when {
    isMorning(c) -> "صباح الخير يا ابن الصحراء"
    isNight(c) -> "ليلة هادئة يا دليل القافلة"
    else -> "أهلًا بك في الواحة"
}

fun currentSky(c: Context): String = when {
    isNight(c) -> "🌙"
    isMorning(c) -> "🌅"
    else -> "☀️"
}

fun safeRoutineName(name: String): String =
    name.trim().replace(Regex("\\s+"), " ").take(60)

fun safeEmoji(value: String): String =
    value.trim().take(4).ifBlank { "🌴" }

fun safeSeconds(value: String): Int =
    value.filter(Char::isDigit).toIntOrNull()?.coerceIn(0, 3600) ?: 0

fun nextScheduledTime(context: Context, slot: String): Long {
    val cal = Calendar.getInstance().apply {
        set(Calendar.HOUR_OF_DAY, Store.alarmHour(context, slot))
        set(Calendar.MINUTE, Store.alarmMinute(context, slot))
        set(Calendar.SECOND, 0)
        set(Calendar.MILLISECOND, 0)
        if (timeInMillis <= System.currentTimeMillis()) add(Calendar.DAY_OF_YEAR, 1)
    }
    return cal.timeInMillis
}

fun formatRemaining(ms: Long): String {
    val seconds = max(0, ms / 1000)
    val h = seconds / 3600
    val m = (seconds % 3600) / 60
    val s = seconds % 60
    return "%02d:%02d:%02d".format(h, m, s)
}

fun buildRoutineId(): Long = System.currentTimeMillis() * 10 + (0..9).random()

fun copyRoutine(r: Routine): Routine = r.copy(id = buildRoutineId())

fun sortedRoutines(context: Context): List<Routine> =
    Store.routines(context).sortedWith(compareBy<Routine> { it.slot }.thenBy { it.name })

fun dueRoutineNames(context: Context): List<String> =
    Store.routines(context).filter { routineDue(context, it) }.map { it.name }

fun lockRoutineNames(context: Context): List<String> =
    Store.routines(context).filter { it.locks && routineDue(context, it) }.map { it.name }

fun hasAnyDue(context: Context): Boolean = dueRoutineNames(context).isNotEmpty()

fun hasLockDue(context: Context): Boolean = lockRoutineNames(context).isNotEmpty()

fun streakNow(context: Context): Int {
    val log = Store.log(context)
    var streak = 0
    var i = 0
    while (log.any { it.date == dateStamp(i) }) {
        streak++
        i++
        if (i > 3650) break
    }
    return streak
}

fun firstAchievementDate(context: Context): String? =
    Store.log(context).minByOrNull { it.date }?.date

fun lastAchievementDate(context: Context): String? =
    Store.log(context).maxByOrNull { it.date }?.date

fun routineCount(context: Context): Int = Store.routines(context).size

fun lockedRoutineCount(context: Context): Int = Store.routines(context).count { it.locks }

fun oathRoutineCount(context: Context): Int = Store.routines(context).count { it.oath }

fun timedRoutineCount(context: Context): Int = Store.routines(context).count { it.mandatoryTimer }

fun activeDays(context: Context): Int = Store.log(context).map { it.date }.toSet().size

fun averageDailyCompletions(context: Context): Float {
    val days = max(1, activeDays(context))
    return Store.log(context).size.toFloat() / days
}

fun xpNeededForNextRank(context: Context): Int =
    max(0, nextRankXp(Store.xp(context)) - Store.xp(context))

fun badgeCount(context: Context): Int = badges(context).size

fun hasBadge(context: Context, badge: String): Boolean = badge in badges(context)

fun morningWindowText(context: Context): String {
    val w = Store.window(context, "morning")
    return "${formatMinutes(w.first)} – ${formatMinutes(w.second)}"
}

fun nightWindowText(context: Context): String {
    val w = Store.window(context, "night")
    return "${formatMinutes(w.first)} – ${formatMinutes(w.second)}"
}

fun alarmSummary(context: Context): String =
    "الصباح ${nextAlarmText(context, "morning")} • الليل ${nextAlarmText(context, "night")}"

fun locationSummary(context: Context): String =
    if (hasLocationPermission(context)) "الموقع مسموح" else "الموقع غير مسموح"

fun notificationSummary(context: Context): String =
    if (hasNotificationPermission(context)) "الإشعارات مسموحة" else "الإشعارات غير مسموحة"

fun accessibilitySummary(context: Context): String =
    if (hasAccessibility(context)) "خدمة الإتاحة مفعلة" else "خدمة الإتاحة غير مفعلة"

fun exactAlarmSummary(context: Context): String =
    if (canExactAlarm(context)) "المنبهات الدقيقة مسموحة" else "المنبهات الدقيقة غير مسموحة"

fun settingsSummary(context: Context): List<String> = listOf(
    accessibilitySummary(context),
    notificationSummary(context),
    locationSummary(context),
    exactAlarmSummary(context)
)

fun canUseLock(context: Context): Boolean =
    Store.isLockEnabled(context) && hasAccessibility(context)

fun lockWarning(context: Context): String =
    if (canUseLock(context)) "القفل جاهز" else "فعّل خدمة الإتاحة ليعمل القفل"

fun routineById(context: Context, id: Long): Routine? =
    Store.routines(context).firstOrNull { it.id == id }

fun logForRoutine(context: Context, id: Long): List<LogEntry> =
    Store.log(context).filter { it.routineId == id }

fun routineCompletions(context: Context, id: Long): Int =
    logForRoutine(context, id).size

fun routineLastCompleted(context: Context, id: Long): String? =
    logForRoutine(context, id).maxByOrNull { it.date }?.date

fun allBadgesUnlocked(context: Context): Boolean =
    badges(context).contains("سلطان الرمال")

fun appStatus(context: Context): String =
    if (canUseLock(context)) "نشط" else "يحتاج إعداد"

fun recommendation(context: Context): String = when {
    Store.log(context).isEmpty() -> "ابدأ بروتين تفريش الصباح؛ الاستمرارية أهم من الكمال."
    streakNow(context) < 3 -> "حافظ على الروتين ثلاثة أيام متتالية قبل إضافة عادات كثيرة."
    Store.xp(context) < 300 -> "اقترب من وسام 300 نقطة؛ أكمل روتينًا واحدًا اليوم."
    else -> "ممتاز. ركز الآن على الحفاظ على السلسلة."
}

@Composable
fun CompactStatus(context: Context) {
    val status = settingsSummary(context)
    Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
        status.forEach { Text("• $it", fontSize = 13.sp) }
    }
}

@Composable
fun BadgeRow(context: Context) {
    val list = badges(context)
    if (list.isEmpty()) {
        Text("لم تفتح أي وسام بعد.", color = LightPalette.muted)
    } else {
        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
            list.take(4).forEach { Text("🏅 $it", fontSize = 12.sp) }
        }
    }
}

@Composable
fun ProgressToRank(context: Context) {
    val xp = Store.xp(context)
    val progress = rankProgress(xp)
    Column(verticalArrangement = Arrangement.spacedBy(5.dp)) {
        Text("التقدم نحو الرتبة التالية")
        LinearProgressIndicator(progress = { progress }, Modifier.fillMaxWidth())
        Text("${xpNeededForNextRank(context)} XP متبقية", fontSize = 12.sp)
    }
}

@Composable
fun HomeFooter(context: Context) {
    Card {
        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
            Text(recommendation(context), fontWeight = FontWeight.Bold)
            CompactStatus(context)
            BadgeRow(context)
            ProgressToRank(context)
        }
    }
}

fun installDefaults(context: Context) {
    if (Store.routines(context).isEmpty()) Store.saveRoutines(context, defaultRoutines())
}

fun onAppResume(context: Context) {
    initialize(context)
}

fun onRoutineCompleted(context: Context, routine: Routine) {
    Store.complete(context, routine)
    NotificationHelper.createChannel(context)
}

fun emergencyActive(context: Context): Boolean =
    Store.emergencyUntil(context) > System.currentTimeMillis()

fun emergencyRemaining(context: Context): Long =
    max(0, Store.emergencyUntil(context) - System.currentTimeMillis())

fun lockReason(context: Context): String =
    dueLockedRoutine(context)?.name?.let { "الروتين المستحق: $it" } ?: "لا يوجد قفل مستحق"

fun appVersion(): String = "1.0"

fun buildInfo(): String = "الواحة $appVersion • Android Native • Kotlin"

fun allDays(): Set<Int> = setOf(
    Calendar.SUNDAY,
    Calendar.MONDAY,
    Calendar.TUESDAY,
    Calendar.WEDNESDAY,
    Calendar.THURSDAY,
    Calendar.FRIDAY,
    Calendar.SATURDAY
)

fun weekendDays(): Set<Int> = setOf(Calendar.FRIDAY, Calendar.SATURDAY)

fun weekdayDays(): Set<Int> = allDays() - weekendDays()

fun routineWithDefaultDays(
    name: String,
    emoji: String,
    slot: String,
    steps: List<Step>
): Routine = Routine(
    buildRoutineId(),
    safeRoutineName(name),
    safeEmoji(emoji),
    slot,
    allDays(),
    steps,
    true,
    true,
    false
)

fun cloneAsLocking(r: Routine): Routine = r.copy(id = buildRoutineId(), locks = true)

fun cloneWithoutOath(r: Routine): Routine = r.copy(id = buildRoutineId(), oath = false)

fun cloneWithFreeTimer(r: Routine): Routine = r.copy(id = buildRoutineId(), mandatoryTimer = false)

fun minutesBetween(start: Int, end: Int): Int =
    if (end >= start) end - start else (1440 - start) + end

fun validateWindow(start: Int, end: Int): Boolean =
    start in 0..1439 && end in 0..1439 && minutesBetween(start, end) > 0

fun parseClock(text: String): Int? {
    val parts = text.split(":")
    if (parts.size != 2) return null
    val h = parts[0].toIntOrNull() ?: return null
    val m = parts[1].toIntOrNull() ?: return null
    return if (h in 0..23 && m in 0..59) h * 60 + m else null
}

fun currentClock(): String = formatMinutes(currentMinute())

fun todayArabicName(): String = when (dayOfWeek()) {
    Calendar.SUNDAY -> "الأحد"
    Calendar.MONDAY -> "الاثنين"
    Calendar.TUESDAY -> "الثلاثاء"
    Calendar.WEDNESDAY -> "الأربعاء"
    Calendar.THURSDAY -> "الخميس"
    Calendar.FRIDAY -> "الجمعة"
    else -> "السبت"
}

fun monthArabicName(): String {
    val c = Calendar.getInstance()
    return SimpleDateFormat("MMMM", Locale("ar")).format(c.time)
}

fun formattedToday(): String =
    SimpleDateFormat("EEEE، d MMMM", Locale("ar")).format(Date())

fun notificationId(slot: String): Int = if (slot == "morning") 700 else 701

fun requestCodes(): Set<Int> = setOf(MORNING_REQ, NIGHT_REQ)

fun packageName(): String = "com.alwaha.app"

fun isSamsung(): Boolean = Build.MANUFACTURER.equals("samsung", true)

