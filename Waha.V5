        onDismissRequest = onDismiss,
        title = { Text("نافذة ${slotLabel(slot)}") },
        text = {
            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
                Text("البداية: ${formatMinutes(start)}")
                Slider(value = start.toFloat(), onValueChange = { start = it.toInt() }, valueRange = 0f..1439f)
                Text("النهاية: ${formatMinutes(end)}")
                Slider(value = end.toFloat(), onValueChange = { end = it.toInt() }, valueRange = 0f..1439f)
            }
        },
        confirmButton = { Button(onClick = { onSave(start, end) }) { Text("حفظ") } },
        dismissButton = { TextButton(onClick = onDismiss) { Text("إلغاء") } }
    )
}

object PrayerApi {
    private val executor = Executors.newSingleThreadExecutor()

    fun load(context: Context, callback: (PrayerTimes) -> Unit) {
        executor.execute {
            val lm = context.getSystemService(Context.LOCATION_SERVICE) as LocationManager
            var loc: Location? = null
            if (ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED) {
                runCatching {
                    val providers = lm.getProviders(true)
                    providers.forEach { provider ->
                        val candidate = lm.getLastKnownLocation(provider)
                        if (candidate != null && (loc == null || candidate.accuracy < loc!!.accuracy)) loc = candidate
                    }
                }
            }
            val latitude = loc?.latitude ?: 51.5074
            val longitude = loc?.longitude ?: -0.1278
            val date = SimpleDateFormat("dd-MM-yyyy", Locale.US).format(Date())
            val url = URL("https://api.aladhan.com/v1/timings/$date?latitude=$latitude&longitude=$longitude&method=3")
            runCatching {
                val conn = url.openConnection() as HttpURLConnection
                conn.connectTimeout = 7000
                conn.readTimeout = 7000
                conn.requestMethod = "GET"
                val text = conn.inputStream.bufferedReader().use { it.readText() }
                val o = JSONObject(text).getJSONObject("data").getJSONObject("timings")
                val p = PrayerTimes(
                    o.optString("Fajr", "--:--").take(5),
                    o.optString("Dhuhr", "--:--").take(5),
                    o.optString("Asr", "--:--").take(5),
                    o.optString("Maghrib", "--:--").take(5),
                    o.optString("Isha", "--:--").take(5)
                )
                android.os.Handler(context.mainLooper).post { callback(p) }
            }.onFailure {
                android.os.Handler(context.mainLooper).post { callback(PrayerTimes()) }
            }
        }
    }
}

object AlarmScheduler {
    fun scheduleAll(context: Context) {
        schedule(context, "morning", Store.alarmHour(context, "morning"), Store.alarmMinute(context, "morning"), MORNING_REQ)
        schedule(context, "night", Store.alarmHour(context, "night"), Store.alarmMinute(context, "night"), NIGHT_REQ)
    }

    private fun schedule(context: Context, slot: String, hour: Int, minute: Int, request: Int) {
        val am = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
        val intent = Intent(context, AlarmReceiver::class.java).putExtra(EXTRA_SLOT, slot)
        val pi = PendingIntent.getBroadcast(
            context, request, intent,
            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
        )
        val cal = Calendar.getInstance().apply {
            set(Calendar.HOUR_OF_DAY, hour)
            set(Calendar.MINUTE, minute)
            set(Calendar.SECOND, 0)
            set(Calendar.MILLISECOND, 0)
            if (timeInMillis <= System.currentTimeMillis()) add(Calendar.DAY_OF_YEAR, 1)
        }
        if (Build.VERSION.SDK_INT >= 31 && !am.canScheduleExactAlarms()) {
            am.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, cal.timeInMillis, pi)
        } else {
            am.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, cal.timeInMillis, pi)
        }
    }
}

class AlarmReceiver : android.content.BroadcastReceiver() {
    override fun onReceive(context: Context, intent: Intent) {
        NotificationHelper.notifyRoutine(context, intent.getStringExtra(EXTRA_SLOT) ?: "morning")
        AlarmScheduler.scheduleAll(context)
    }
}

class BootReceiver : android.content.BroadcastReceiver() {
    override fun onReceive(context: Context, intent: Intent) {
        if (intent.action == Intent.ACTION_BOOT_COMPLETED || intent.action == Intent.ACTION_MY_PACKAGE_REPLACED) {
            NotificationHelper.createChannel(context)
            AlarmScheduler.scheduleAll(context)
        }
    }
}

object NotificationHelper {
    fun createChannel(context: Context) {
        val nm = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
        if (Build.VERSION.SDK_INT >= 26) {
            nm.createNotificationChannel(
                NotificationChannel(CHANNEL, "تنبيهات الواحة", NotificationManager.IMPORTANCE_HIGH).apply {
                    description = "تذكيرات روتينات الصباح والليل"
                }
            )
        }
    }

    fun notifyRoutine(context: Context, slot: String) {
        createChannel(context)
        if (Build.VERSION.SDK_INT >= 33 &&
            ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
        ) return
        val launch = PendingIntent.getActivity(
            context, if (slot == "morning") 910 else 911,
            Intent(context, MainActivity::class.java).apply {
                flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP
            },
            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
        )
        val builder = androidx.core.app.NotificationCompat.Builder(context, CHANNEL)
            .setSmallIcon(android.R.drawable.ic_dialog_info)
            .setContentTitle(if (slot == "morning") "صباح الواحة 🌅" else "ليلة الواحة 🌙")
            .setContentText(if (slot == "morning") "حان وقت روتين الصباح." else "حان وقت روتين الليل.")
            .setAutoCancel(true)
            .setContentIntent(launch)
            .setPriority(androidx.core.app.NotificationCompat.PRIORITY_HIGH)
        androidx.core.app.NotificationManagerCompat.from(context).notify(if (slot == "morning") 700 else 701, builder.build())
    }
}

class AlwahaAccessibilityService : AccessibilityService() {
    private var lastLaunch = 0L

    override fun onServiceConnected() {
        super.onServiceConnected()
        serviceInfo = serviceInfo.apply {
            eventTypes = AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED or AccessibilityEvent.TYPE_WINDOWS_CHANGED
            notificationTimeout = 100
        }
    }

    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
        val packageName = event?.packageName?.toString() ?: return
        val now = System.currentTimeMillis()
        if (now - lastLaunch < 1200) return
        if (packageName == applicationContext.packageName) return
        if (isExempt(packageName)) return
        if (Store.emergencyUntil(applicationContext) > now) return
        val due = dueLockedRoutine(applicationContext) ?: return
        lastLaunch = now
        val intent = Intent(this, MainActivity::class.java).apply {
            flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP or Intent.FLAG_ACTIVITY_SINGLE_TOP
            putExtra("locked", true)
            putExtra("routineId", due.id)
        }
        startActivity(intent)
    }

    private fun isExempt(pkg: String): Boolean {
        val lower = pkg.lowercase(Locale.US)
        if (lower == "com.android.systemui") return true
        if (lower.contains("inputmethod")) return true
        if (lower.contains("keyboard")) return true
        if (lower == "com.android.permissioncontroller") return true
        if (lower == "com.google.android.packageinstaller") return true
        if (lower.contains("installer")) return true
        if (lower.contains("dialer")) return true
        if (lower.contains("telecom")) return true
        if (lower.contains("emergency")) return true
        return false
    }

    override fun onInterrupt() = Unit
}

''')

