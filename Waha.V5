fun finalHelp(): String =
    listOf(
        samsungRestrictedText(),
        samsungAccessibilityText(),
        samsungBatteryText(),
        installNote()
    ).joinToString("\n")

fun diagnostic(context: Context): Map<String, String> = mapOf(
    "lock" to lockWarning(context),
    "accessibility" to accessibilitySummary(context),
    "notifications" to notificationSummary(context),
    "location" to locationSummary(context),
    "exactAlarm" to exactAlarmSummary(context)
)

fun diagnosticsText(context: Context): String =
    diagnostic(context).entries.joinToString("\n") { "${it.key}: ${it.value}" }

fun resetAndReschedule(context: Context) {
    Store.reset(context)
    AlarmScheduler.scheduleAll(context)
}

fun completeRoutine(context: Context, routine: Routine) {
    if (!Store.isDoneToday(context, routine.id)) {
        Store.complete(context, routine)
        NotificationHelper.createChannel(context)
    }
}

fun canStartRoutine(context: Context, routine: Routine): Boolean =
    routineValid(routine) && (!routine.locks || Store.isLockEnabled(context))

fun routineDueReason(context: Context, routine: Routine): String =
    when {
        Store.isDoneToday(context, routine.id) -> "منجز اليوم"
        !routineMatchesDay(routine, effectiveDay(context)) -> "ليس من أيامه"
        routine.slot == "morning" && !inWindow(context, "morning") -> "خارج نافذة الصباح"
        routine.slot == "night" && !inWindow(context, "night") -> "خارج نافذة الليل"
        else -> "مستحق"
    }

fun routineCardSubtitle(context: Context, routine: Routine): String =
    if (routineDue(context, routine)) "مستحق الآن" else routineDueReason(context, routine)

fun safeLogCount(context: Context): Int = Store.log(context).size

fun safeXp(context: Context): Int = Store.xp(context)

fun safeStreak(context: Context): Int = streakNow(context)

fun safeRank(context: Context): String = rankForXp(Store.xp(context))

fun safeBadgeCount(context: Context): Int = badges(context).size

fun safeRoutineCount(context: Context): Int = Store.routines(context).size

fun safeLockState(context: Context): Boolean = Store.isLockEnabled(context)

fun safeEmergencyState(context: Context): Boolean = emergencyActive(context)

fun safePrayerLocation(context: Context): String =
    if (hasLocationPermission(context)) "موقع تقريبي" else "London fallback"

fun safeNotificationState(context: Context): Boolean = hasNotificationPermission(context)

fun safeAccessibilityState(context: Context): Boolean = hasAccessibility(context)

