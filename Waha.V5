fun formatMinutes(value: Int): String = "%02d:%02d".format(value / 60, value % 60)

@Composable
fun TimeWindowDialog(slot: String, onDismiss: () -> Unit, onSave: (Int, Int) -> Unit) {
    val context = LocalContext.current
    var start by remember { mutableIntStateOf(Store.window(context, slot).first) }
    var end by remember { mutableIntStateOf(Store.window(context, slot).second) }
