''')

# Add missing navigation create entry and auto init using a separate small patch via replacing library screen action
kt_full = kt + extra
# Ensure source initializes app and has create navigation reachable: use a simple intent flag path in Home not enough.
# Patch AlwahaApp: library screen can only back/open. We'll use settings create not accessible. Better add create button in Library by making onOpen special impossible.
# We'll replace LibraryScreen signature and call with create callback.
kt_full = kt_full.replace(
'LibraryScreen(\n                    onBack = { page = "home" },\n                    onOpen = { selected = it; page = "routine" }\n                )',
'LibraryScreen(\n                    onBack = { page = "home" },\n                    onOpen = { selected = it; page = "routine" },\n                    onCreate = { page = "create" }\n                )'
)
kt_full = kt_full.replace(
'fun LibraryScreen(onBack: () -> Unit, onOpen: (Routine) -> Unit) {',
'fun LibraryScreen(onBack: () -> Unit, onOpen: (Routine) -> Unit, onCreate: () -> Unit) {'
)
kt_full = kt_full.replace(
'actions = { IconButton(onClick = { /* create below */ }) { Icon(Icons.Default.Add, null) } }',
'actions = { IconButton(onClick = onCreate) { Icon(Icons.Default.Add, null) } }'
)

# Need import androidx.compose.ui.graphics? already.
# Need MainActivity initialization before setContent and theme AUTO handling. Patch.
kt_full = kt_full.replace(
'override fun onCreate(savedInstanceState: Bundle?) {\n        super.onCreate(savedInstanceState)\n        window.addFlags',
'override fun onCreate(savedInstanceState: Bundle?) {\n        super.onCreate(savedInstanceState)\n        initialize(this)\n        window.addFlags'
)

# Count lines
len(kt_full.splitlines())
