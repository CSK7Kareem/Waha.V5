    var mode by remember { mutableStateOf(Store.mode(context)) }
    var theme by remember { mutableStateOf(Store.theme(context)) }
    var showTime by remember { mutableStateOf(false) }
    var slotTime by remember { mutableStateOf("morning") }
    var start by remember { mutableStateOf(Store.window(context, "morning").first) }
    var end by remember { mutableStateOf(Store.window(context, "morning").second) }

    Scaffold(
        topBar = {
            TopAppBar(
