private const val PREFS = "alwaha"
private const val KEY_ROUTINES = "routines"
private const val KEY_LOG = "log"
private const val KEY_XP = "xp"
private const val KEY_LOCK = "lock"
private const val KEY_EXACT = "exact"
private const val KEY_WELCOME = "welcome"
private const val KEY_MODE = "mode"
private const val KEY_THEME = "theme"
private const val KEY_MORNING_START = "morningStart"
private const val KEY_MORNING_END = "morningEnd"
private const val KEY_NIGHT_START = "nightStart"
private const val KEY_NIGHT_END = "nightEnd"
private const val KEY_MORNING_ALARM = "morningAlarm"
private const val KEY_NIGHT_ALARM = "nightAlarm"
private const val KEY_EMERGENCY_UNTIL = "emergencyUntil"
private const val CHANNEL = "alwaha_routines"
private const val EXTRA_SLOT = "slot"
private const val MORNING_REQ = 7001
private const val NIGHT_REQ = 7002

data class Step(
    val text: String,
    val seconds: Int
)

data class Routine(
    val id: Long,
    val name: String,
    val emoji: String,
    val slot: String,
    val days: Set<Int>,
    val steps: List<Step>,
    val oath: Boolean,
    val mandatoryTimer: Boolean,
    val locks: Boolean
)

data class LogEntry(
    val date: String,
    val routineId: Long,
    val xp: Int
)

data class PrayerTimes(
    val fajr: String = "--:--",
    val dhuhr: String = "--:--",
    val asr: String = "--:--",
    val maghrib: String = "--:--",
    val isha: String = "--:--"
)

object Store {
    private fun p(c: Context) = c.getSharedPreferences(PREFS, Context.MODE_PRIVATE)

    fun routines(c: Context): MutableList<Routine> {
        val raw = p(c).getString(KEY_ROUTINES, null)
        if (raw.isNullOrBlank()) {
            val list = defaultRoutines()
            saveRoutines(c, list)
            return list.toMutableList()
        }
        return runCatching {
            val a = JSONArray(raw)
            MutableList(a.length()) { i -> routineFromJson(a.getJSONObject(i)) }
        }.getOrElse {
            defaultRoutines().toMutableList()
        }
    }

    fun saveRoutines(c: Context, list: List<Routine>) {
        val a = JSONArray()
        list.forEach { a.put(routineToJson(it)) }
        p(c).edit().putString(KEY_ROUTINES, a.toString()).apply()
    }

    fun addRoutine(c: Context, routine: Routine) {
        val list = routines(c)
        list.add(routine)
        saveRoutines(c, list)
    }

    fun deleteRoutine(c: Context, id: Long) {
        saveRoutines(c, routines(c).filterNot { it.id == id })
    }

    fun xp(c: Context): Int = p(c).getInt(KEY_XP, 0)

    fun addXp(c: Context, amount: Int) {
        p(c).edit().putInt(KEY_XP, max(0, xp(c) + amount)).apply()
    }

    fun log(c: Context): MutableList<LogEntry> {
        val raw = p(c).getString(KEY_LOG, null) ?: return mutableListOf()
        return runCatching {
            val a = JSONArray(raw)
            MutableList(a.length()) { i ->
                val o = a.getJSONObject(i)
                LogEntry(o.getString("date"), o.getLong("routineId"), o.getInt("xp"))
            }
        }.getOrElse { mutableListOf() }
    }

    fun complete(c: Context, routine: Routine) {
        val list = log(c)
        val today = dayKey()
        if (list.any { it.date == today && it.routineId == routine.id }) return
        list.add(LogEntry(today, routine.id, 25))
        val a = JSONArray()
        list.takeLast(500).forEach {
            a.put(JSONObject().put("date", it.date).put("routineId", it.routineId).put("xp", it.xp))
        }
        p(c).edit().putString(KEY_LOG, a.toString()).apply()
        addXp(c, 25)
    }

    fun isDoneToday(c: Context, id: Long): Boolean =
        log(c).any { it.date == dayKey() && it.routineId == id }

    fun isLockEnabled(c: Context): Boolean = p(c).getBoolean(KEY_LOCK, true)

    fun setLockEnabled(c: Context, value: Boolean) {
        p(c).edit().putBoolean(KEY_LOCK, value).apply()
    }

    fun mode(c: Context): String = p(c).getString(KEY_MODE, "AUTO") ?: "AUTO"

    fun setMode(c: Context, value: String) {
        p(c).edit().putString(KEY_MODE, value).apply()
    }

    fun theme(c: Context): String = p(c).getString(KEY_THEME, "LIGHT") ?: "LIGHT"

    fun setTheme(c: Context, value: String) {
        p(c).edit().putString(KEY_THEME, value).apply()
    }

    fun emergencyUntil(c: Context): Long = p(c).getLong(KEY_EMERGENCY_UNTIL, 0)

    fun setEmergencyUntil(c: Context, value: Long) {
        p(c).edit().putLong(KEY_EMERGENCY_UNTIL, value).apply()
    }

    fun alarmHour(c: Context, slot: String): Int =
        p(c).getInt(if (slot == "morning") KEY_MORNING_ALARM else KEY_NIGHT_ALARM, if (slot == "morning") 7 else 22)

    fun alarmMinute(c: Context, slot: String): Int =
        p(c).getInt(if (slot == "morning") "morningAlarmMinute" else "nightAlarmMinute", 0)

    fun setAlarm(c: Context, slot: String, hour: Int, minute: Int) {
        p(c).edit()
            .putInt(if (slot == "morning") KEY_MORNING_ALARM else KEY_NIGHT_ALARM, hour)
            .putInt(if (slot == "morning") "morningAlarmMinute" else "nightAlarmMinute", minute)
            .apply()
    }

    fun window(c: Context, slot: String): Pair<Int, Int> {
        val startKey = if (slot == "morning") KEY_MORNING_START else KEY_NIGHT_START
        val endKey = if (slot == "morning") KEY_MORNING_END else KEY_NIGHT_END
        val start = p(c).getInt(startKey, if (slot == "morning") 6 * 60 else 21 * 60)
        val end = p(c).getInt(endKey, if (slot == "morning") 12 * 60 else 6 * 60)
        return start to end
    }

    fun setWindow(c: Context, slot: String, start: Int, end: Int) {
        val sk = if (slot == "morning") KEY_MORNING_START else KEY_NIGHT_START
        val ek = if (slot == "morning") KEY_MORNING_END else KEY_NIGHT_END
        p(c).edit().putInt(sk, start).putInt(ek, end).apply()
    }

    fun firstRun(c: Context): Boolean = !p(c).getBoolean(KEY_WELCOME, false)

    fun markFirstRunDone(c: Context) {
        p(c).edit().putBoolean(KEY_WELCOME, true).apply()
    }

    fun reset(c: Context) {
        p(c).edit().clear().apply()
        saveRoutines(c, defaultRoutines())
    }
}

private fun routineToJson(r: Routine): JSONObject =
    JSONObject()
        .put("id", r.id)
        .put("name", r.name)
        .put("emoji", r.emoji)
        .put("slot", r.slot)
        .put("days", JSONArray(r.days.toList()))
        .put("oath", r.oath)
        .put("mandatoryTimer", r.mandatoryTimer)
        .put("locks", r.locks)
        .put("steps", JSONArray().also { a ->
            r.steps.forEach { a.put(JSONObject().put("text", it.text).put("seconds", it.seconds)) }
        })

private fun routineFromJson(o: JSONObject): Routine {
    val daysA = o.optJSONArray("days") ?: JSONArray()
    val days = mutableSetOf<Int>()
    for (i in 0 until daysA.length()) days.add(daysA.getInt(i))
    val stepsA = o.optJSONArray("steps") ?: JSONArray()
    val steps = MutableList(stepsA.length()) { i ->
        val s = stepsA.getJSONObject(i)
        Step(s.optString("text", "خطوة"), max(0, s.optInt("seconds", 0)))
    }
    return Routine(
        o.optLong("id", System.currentTimeMillis()),
        o.optString("name", "روتين"),
        o.optString("emoji", "🌴"),
        o.optString("slot", "any"),
        days,
        steps,
        o.optBoolean("oath", true),
        o.optBoolean("mandatoryTimer", true),
        o.optBoolean("locks", false)
    )
}

private fun defaultRoutines(): List<Routine> {
    val all = setOf(1, 2, 3, 4, 5, 6, 7)
    fun r(id: Long, name: String, emoji: String, slot: String, steps: List<Step>, oath: Boolean = true, lock: Boolean = true) =
        Routine(id, name, emoji, slot, all, steps, oath, true, lock)
    return listOf(
        r(1, "تفريش الصباح", "🪥", "morning", listOf(Step("ضع المعجون ونظف الأسنان جيدًا", 120))),
        r(2, "تفريش الليل", "🌙", "night", listOf(Step("نظف الأسنان واللثة بهدوء", 120))),
        r(3, "الوضوء والأذكار", "🕌", "any", listOf(Step("توضأ بهدوء", 180), Step("اقرأ أذكارك", 120)), true, false),
        r(4, "كوب ماء ونَفَس عميق", "💧", "morning", listOf(Step("اشرب كوب ماء", 30), Step("خذ خمسة أنفاس عميقة", 60)), false, false),
        r(5, "شرب الماء", "🥤", "any", listOf(Step("اشرب كوب ماء", 30)), false, false),
        r(6, "أذكار المساء", "🌆", "night", listOf(Step("اقرأ أذكار المساء", 180)), true, false),
        r(7, "العناية بالبشرة", "🧴", "night", listOf(Step("نظف وجهك", 60), Step("ضع العناية المناسبة", 60)), false, false),
        r(8, "تمارين الصباح", "🏃", "morning", listOf(Step("تمدد", 60), Step("تمارين خفيفة", 300)), false, false),
        r(9, "تجهيز النوم", "🛏️", "night", listOf(Step("أغلق الشاشات", 120), Step("جهز ملابس الغد", 120)), false, false),
        r(10, "ترتيب الغرفة", "🧹", "any", listOf(Step("رتب الأشياء المتناثرة", 300)), false, false),
        r(11, "القهوة العربية", "☕", "morning", listOf(Step("جهز القهوة بهدوء", 180)), false, false),
        r(12, "مراجعة اليوم", "📖", "night", listOf(Step("راجع أهم إنجازات اليوم", 180)), false, false)
    )
}

fun dayKey(): String = SimpleDateFormat("yyyy-MM-dd", Locale.US).format(Date())

fun currentMinute(): Int {
    val c = Calendar.getInstance()
    return c.get(Calendar.HOUR_OF_DAY) * 60 + c.get(Calendar.MINUTE)
}

fun dayOfWeek(): Int = Calendar.getInstance().get(Calendar.DAY_OF_WEEK)

fun effectiveDay(c: Context): Int {
    val now = currentMinute()
    val morningStart = Store.window(c, "morning").first
    return if (now < morningStart - 60) {
        val cal = Calendar.getInstance()
        cal.add(Calendar.DAY_OF_YEAR, -1)
        cal.get(Calendar.DAY_OF_WEEK)
    } else dayOfWeek()
}

fun inWindow(c: Context, slot: String): Boolean {
    val now = currentMinute()
    val (start, end) = Store.window(c, slot)
    return if (start <= end) now in start..end else now >= start || now <= end
}

fun routineDue(c: Context, r: Routine): Boolean {
    if (Store.isDoneToday(c, r.id)) return false
    val mode = Store.mode(c)
    if (mode == "DAY" && r.slot == "night") return false
    if (mode == "NIGHT" && r.slot == "morning") return false
    if (mode == "MORNING" && r.slot != "morning") return false
    if (r.days.isNotEmpty() && !r.days.contains(effectiveDay(c))) return false
    return when (r.slot) {
        "morning" -> inWindow(c, "morning")
        "night" -> inWindow(c, "night")
        else -> true
    }
}

fun dueLockedRoutine(c: Context): Routine? =
    Store.routines(c).firstOrNull { it.locks && routineDue(c, it) && Store.isLockEnabled(c) }

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
        setContent { AlwahaApp() }
    }

    override fun onNewIntent(intent: Intent?) {
        super.onNewIntent(intent)
        intent?.getStringExtra("startRoutine")?.let { /* state is selected by launch path */ }
    }
}

@Composable
fun AlwahaApp() {
    val context = LocalContext.current
    var page by remember { mutableStateOf(if (Store.firstRun(context)) "welcome" else "home") }
    var selected by remember { mutableStateOf<Routine?>(null) }
    var refresh by remember { mutableIntStateOf(0) }
    val dark = Store.theme(context) == "DARK"
    val palette = if (dark) DarkPalette else LightPalette

    MaterialTheme(
        colorScheme = if (dark) darkScheme else lightScheme
    ) {
        Surface(modifier = Modifier.fillMaxSize(), color = palette.background) {
            when (page) {
                "welcome" -> WelcomeScreen {
                    Store.markFirstRunDone(context)
                    page = "home"
                }
                "home" -> HomeScreen(
                    onOpenRoutine = { selected = it; page = "routine" },
                    onPage = { page = it },
                    refresh = refresh
                )
                "stats" -> StatsScreen(onBack = { page = "home" })
                "settings" -> SettingsScreen(
                    onBack = { page = "home" },
                    onChanged = { refresh++ }
                )
                "library" -> LibraryScreen(
                    onBack = { page = "home" },
                    onOpen = { selected = it; page = "routine" }
                )
                "create" -> CreateRoutineScreen(
                    onBack = { page = "library" },
                    onSaved = { refresh++; page = "library" }
                )
                "routine" -> selected?.let {
                    RoutineScreen(
                        routine = it,
                        onBack = { page = "home" },
                        onDone = { refresh++; page = "home" }
                    )
                }
                else -> HomeScreen({}, { page = "home" }, refresh)
            }
        }
    }
}

data class AppPalette(
    val background: Color,
    val surface: Color,
    val sand: Color,
    val gold: Color,
    val teal: Color,
    val indigo: Color,
    val text: Color,
    val muted: Color
)

val LightPalette = AppPalette(
    Color(0xFFF5E8CE), Color(0xFFFFF8EA), Color(0xFFD8B27A),
    Color(0xFFC8943D), Color(0xFF168A87), Color(0xFF26365E),
    Color(0xFF382A1E), Color(0xFF806E5B)
)

val DarkPalette = AppPalette(
    Color(0xFF151820), Color(0xFF20232D), Color(0xFF8C6A43),
    Color(0xFFD5A552), Color(0xFF37AAA5), Color(0xFF53658F),
    Color(0xFFF5E9D2), Color(0xFFB8AD9E)
)

val lightScheme = androidx.compose.material3.lightColorScheme(
    primary = Color(0xFF168A87),
    secondary = Color(0xFFC8943D),
    tertiary = Color(0xFF26365E),
    background = Color(0xFFF5E8CE),
    surface = Color(0xFFFFF8EA)
)

val darkScheme = androidx.compose.material3.darkColorScheme(
    primary = Color(0xFF37AAA5),
    secondary = Color(0xFFD5A552),
    tertiary = Color(0xFF8091BE),
    background = Color(0xFF151820),
    surface = Color(0xFF20232D)
)

@Composable
fun DesertBackdrop(modifier: Modifier = Modifier) {
    Canvas(modifier.fillMaxSize()) {
        val w = size.width
        val h = size.height
        drawRect(Color(0x00FFFFFF))
        val dune = Path().apply {
            moveTo(0f, h * .70f)
            cubicTo(w * .18f, h * .56f, w * .33f, h * .78f, w * .50f, h * .64f)
            cubicTo(w * .68f, h * .50f, w * .84f, h * .76f, w, h * .61f)
            lineTo(w, h)
            lineTo(0f, h)
            close()
        }
        drawPath(dune, Color(0x55C8943D))
        val dune2 = Path().apply {
            moveTo(0f, h * .78f)
            cubicTo(w * .25f, h * .66f, w * .55f, h * .84f, w, h * .70f)
            lineTo(w, h)
            lineTo(0f, h)
            close()
        }
        drawPath(dune2, Color(0x44D8B27A))
        drawCircle(Color(0x88F5C85A), 42f, Offset(w * .78f, h * .18f))
        repeat(5) { i ->
            val x = w * (.12f + i * .18f)
            drawLine(Color(0x116B5B3E), Offset(x, h * .1f), Offset(x + 90f, h * .5f), 2f)
        }
    }
}

@Composable
fun HomeScreen(onOpenRoutine: (Routine) -> Unit, onPage: (String) -> Unit, refresh: Int) {
    val context = LocalContext.current
    val routines = remember(refresh) { Store.routines(context) }
    val due = routines.filter { routineDue(context, it) }
    var prayers by remember { mutableStateOf(PrayerTimes()) }
    LaunchedEffect(Unit) { PrayerApi.load(context) { prayers = it } }

    Scaffold(
        contentWindowInsets = WindowInsets.statusBars,
        bottomBar = {
            NavigationBar {
                NavigationBarItem(true, { }, icon = { Icon(Icons.Default.Home, null) }, label = { Text("الرئيسية") })
                NavigationBarItem(false, { onPage("library") }, icon = { Icon(Icons.Default.Add, null) }, label = { Text("الروتينات") })
                NavigationBarItem(false, { onPage("stats") }, icon = { Icon(Icons.Default.BarChart, null) }, label = { Text("الإحصاءات") })
                NavigationBarItem(false, { onPage("settings") }, icon = { Icon(Icons.Default.Settings, null) }, label = { Text("الإعدادات") })
            }
        }
    ) { pad ->
        Box(Modifier.fillMaxSize().padding(pad)) {
            DesertBackdrop()
            LazyColumn(
                modifier = Modifier.fillMaxSize().padding(horizontal = 18.dp),
                verticalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                item { Spacer(Modifier.height(14.dp)) }
                item {
                    Text(
                        "الواحة",
                        fontSize = 36.sp,
                        fontWeight = FontWeight.Bold,
                        color = LightPalette.indigo,
                        modifier = Modifier.fillMaxWidth(),
                        textAlign = TextAlign.Center
                    )
                    Text(
                        "خطوة صغيرة كل يوم تصنع عادة كبيرة",
                        color = LightPalette.text,
                        modifier = Modifier.fillMaxWidth(),
                        textAlign = TextAlign.Center
                    )
                }
                item { XpCard() }
                item {
                    Card(
                        colors = CardDefaults.cardColors(containerColor = Color(0xDDFFF8EA)),
                        shape = RoundedCornerShape(28.dp)
                    ) {
                        Column(Modifier.padding(18.dp)) {
                            Text("مواقيت الصلاة", fontSize = 20.sp, fontWeight = FontWeight.Bold)
                            Spacer(Modifier.height(8.dp))
                            PrayerRow("الفجر", prayers.fajr)
                            PrayerRow("الظهر", prayers.dhuhr)
                            PrayerRow("العصر", prayers.asr)
                            PrayerRow("المغرب", prayers.maghrib)
                            PrayerRow("العشاء", prayers.isha)
                        }
                    }
                }
                item {
                    Text(
                        if (due.isEmpty()) "ما شاء الله، لا يوجد روتين مستحق الآن 🌴" else "الروتينات المستحقة الآن",
                        fontSize = 22.sp,
                        fontWeight = FontWeight.Bold
                    )
                }
                items(due, key = { it.id }) { r ->
                    RoutineCard(r, true) { onOpenRoutine(r) }
                }
                item {
                    Text("روتيناتك", fontSize = 22.sp, fontWeight = FontWeight.Bold)
                }
                items(routines.filterNot { due.contains(it) }.take(8), key = { it.id }) { r ->
                    RoutineCard(r, false) { onOpenRoutine(r) }
                }
                item { Spacer(Modifier.height(18.dp)) }
            }
        }
    }
}

@Composable
fun XpCard() {
    val context = LocalContext.current
    val xp = Store.xp(context)
    val rank = rankForXp(xp)
    Card(colors = CardDefaults.cardColors(containerColor = Color(0xEE26365E)), shape = RoundedCornerShape(28.dp)) {
        Row(
            Modifier.fillMaxWidth().padding(18.dp),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.SpaceBetween
        ) {
            Column {
                Text(rank, color = Color.White, fontSize = 22.sp, fontWeight = FontWeight.Bold)
                Text("$xp XP", color = Color(0xFFE8D4A8), fontSize = 16.sp)
            }
            Text("🌴", fontSize = 42.sp)
        }
    }
}

fun rankForXp(xp: Int): String = when {
    xp >= 1500 -> "سلطان الرمال"
    xp >= 800 -> "شيخ القبيلة"
    xp >= 450 -> "فارس الكثبان"
    xp >= 200 -> "دليل القافلة"
    else -> "ابن الصحراء"
}

@Composable
fun PrayerRow(name: String, time: String) {
    Row(Modifier.fillMaxWidth().padding(vertical = 4.dp), horizontalArrangement = Arrangement.SpaceBetween) {
        Text(name)
        Text(time, fontWeight = FontWeight.Bold)
    }
}

@Composable
fun RoutineCard(r: Routine, due: Boolean, onClick: () -> Unit) {
    Card(
        modifier = Modifier.fillMaxWidth().clickable(onClick = onClick),
        colors = CardDefaults.cardColors(containerColor = if (due) Color(0xFFF4D79D) else Color(0xEFFFFFFF)),
        shape = RoundedCornerShape(topStart = 28.dp, bottomEnd = 28.dp, topEnd = 12.dp, bottomStart = 12.dp)
    ) {
        Row(Modifier.padding(16.dp), verticalAlignment = Alignment.CenterVertically) {
            Text(r.emoji, fontSize = 34.sp)
            Spacer(Modifier.size(12.dp))
            Column(Modifier.weight(1f)) {
                Text(r.name, fontSize = 19.sp, fontWeight = FontWeight.Bold)
                Text("${r.steps.size} خطوات • ${slotLabel(r.slot)}", color = LightPalette.muted)
            }
            if (due) Icon(Icons.Default.PlayArrow, null)
        }
    }
}

fun slotLabel(slot: String): String = when (slot) {
    "morning" -> "صباح"
    "night" -> "ليل"
    else -> "أي وقت"
}

@Composable
fun RoutineScreen(routine: Routine, onBack: () -> Unit, onDone: () -> Unit) {
    val context = LocalContext.current
    var stepIndex by remember { mutableIntStateOf(0) }
    var remaining by remember { mutableIntStateOf(routine.steps.firstOrNull()?.seconds ?: 0) }
    var oathProgress by remember { mutableFloatStateOf(0f) }
    var finished by remember { mutableStateOf(false) }
    var emergency by remember { mutableStateOf(false) }
    val vibration = remember { androidx.compose.ui.platform.LocalHapticFeedback.current }

    LaunchedEffect(stepIndex, routine) {
        remaining = routine.steps.getOrNull(stepIndex)?.seconds ?: 0
        while (remaining > 0) {
            kotlinx.coroutines.delay(1000)
            remaining--
        }
    }

    if (finished) {
        CelebrationScreen(routine, onDone)
        return
    }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text(routine.name) },
                navigationIcon = { IconButton(onClick = onBack) { Icon(Icons.Default.ArrowBack, null) } }
            )
        }
    ) { pad ->
        Column(
            Modifier.fillMaxSize().padding(pad).padding(20.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.spacedBy(18.dp)
        ) {
            Text("${stepIndex + 1} / ${routine.steps.size}", color = LightPalette.muted)
            val step = routine.steps[stepIndex]
            CountdownCircle(remaining, step.seconds)
            Text(step.text, fontSize = 25.sp, fontWeight = FontWeight.Bold, textAlign = TextAlign.Center)
            if (step.seconds > 0) {
                Text(if (remaining == 0) "انتهى الوقت" else "$remaining ثانية", fontSize = 19.sp)
            }
            Spacer(Modifier.height(8.dp))
            Button(
                enabled = remaining == 0 || !routine.mandatoryTimer,
                onClick = {
                    vibration.performHapticFeedback(androidx.compose.ui.hapticfeedback.HapticFeedbackType.LongPress)
                    if (stepIndex < routine.steps.lastIndex) stepIndex++ else finished = true
                },
                modifier = Modifier.fillMaxWidth().height(54.dp)
            ) {
                Text(if (stepIndex == routine.steps.lastIndex) "إنهاء الخطوة" else "الخطوة التالية")
            }
            if (routine.oath && stepIndex == routine.steps.lastIndex && remaining == 0) {
                OathButton(
                    progress = oathProgress,
                    onProgress = { oathProgress = it },
                    onComplete = {
                        Store.complete(context, routine)
                        finished = true
                    }
                )
            }
            OutlinedButton(
                onClick = { emergency = true },
                modifier = Modifier.fillMaxWidth()
            ) { Text("طوارئ: فتح الجوال 10 دقائق") }
        }
    }

    if (emergency) {
        EmergencyDialog(onDismiss = { emergency = false })
    }
}

@Composable
fun CountdownCircle(remaining: Int, total: Int) {
    val fraction = if (total <= 0) 1f else remaining.toFloat() / total
    Box(Modifier.size(210.dp), contentAlignment = Alignment.Center) {
        Canvas(Modifier.fillMaxSize()) {
            drawCircle(Color(0x2237AAA5), style = Stroke(18f))
            drawArc(
                Color(0xFF168A87),
                -90f,
                360f * fraction,
                false,
                style = Stroke(18f, cap = StrokeCap.Round)
            )
        }
        Text("$remaining", fontSize = 48.sp, fontWeight = FontWeight.Bold)
    }
}

@Composable
fun OathButton(progress: Float, onProgress: (Float) -> Unit, onComplete: () -> Unit) {
    var downAt by remember { mutableLongStateOf(0L) }
    var animating by remember { mutableStateOf(false) }
    val anim = remember { Animatable(0f) }
    LaunchedEffect(animating) {
        if (animating) {
            anim.snapTo(0f)
            anim.animateTo(1f, tween(2500))
            if (anim.value >= .999f) onComplete()
            onProgress(anim.value)
            animating = false
        }
    }
    Box(
        Modifier.fillMaxWidth().height(90.dp).clip(RoundedCornerShape(22.dp))
            .background(Color(0xFF26365E))
            .pointerInput(Unit) {
                detectTapGestures(
                    onPress = {
                        downAt = SystemClock.uptimeMillis()
                        animating = true
                        val released = tryAwaitRelease()
                        if (released && SystemClock.uptimeMillis() - downAt < 2500) {
                            animating = false
                            anim.snapTo(0f)
                            onProgress(0f)
                        }
                    }
                )
            },
        contentAlignment = Alignment.Center
    ) {
        LinearProgressIndicator(
            progress = { if (animating) anim.value else progress },
            modifier = Modifier.fillMaxWidth().padding(horizontal = 18.dp),
        )
        Text("أقسم بالله أني أنجزت...", color = Color.White, fontSize = 19.sp, fontWeight = FontWeight.Bold)
    }
}

@Composable
fun CelebrationScreen(routine: Routine, onDone: () -> Unit) {
    val context = LocalContext.current
    Column(
        Modifier.fillMaxSize().padding(28.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        Text("🎉", fontSize = 90.sp)
        Text("أحسنت!", fontSize = 40.sp, fontWeight = FontWeight.Bold)
        Text(routine.name, fontSize = 25.sp, textAlign = TextAlign.Center)
        Text("+25 XP", color = LightPalette.teal, fontSize = 22.sp, fontWeight = FontWeight.Bold)
        Spacer(Modifier.height(24.dp))
        Button(onClick = onDone, modifier = Modifier.fillMaxWidth()) { Text("العودة إلى الواحة") }
    }
}

@Composable
fun EmergencyDialog(onDismiss: () -> Unit) {
    val context = LocalContext.current
    var confirmed by remember { mutableStateOf(false) }
    AlertDialog(
        onDismissRequest = onDismiss,
        title = { Text("حالة طوارئ") },
        text = { Text("سيتم تعطيل القفل لمدة 10 دقائق وخصم 50 نقطة. استخدمها فقط إذا حدث خلل أو احتجت للوصول السريع للجهاز.") },
        confirmButton = {
            Button(onClick = {
                Store.addXp(context, -50)
                Store.setEmergencyUntil(context, System.currentTimeMillis() + 10 * 60 * 1000)
                confirmed = true
                onDismiss()
            }) { Text("تأكيد الطوارئ") }
        },
        dismissButton = { TextButton(onClick = onDismiss) { Text("إلغاء") } }
    )
}

@Composable
fun WelcomeScreen(onFinished: () -> Unit) {
    val context = LocalContext.current
    var step by remember { mutableIntStateOf(0) }
    val notificationLauncher = rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) {}
    val locationLauncher = rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) {}

    Column(
        Modifier.fillMaxSize().padding(24.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        Text("🌙", fontSize = 80.sp)
        Text("مرحبًا بك في الواحة", fontSize = 32.sp, fontWeight = FontWeight.Bold, textAlign = TextAlign.Center)
        Spacer(Modifier.height(14.dp))
        Text(
            when (step) {
                0 -> "سنجهز التطبيق في خطوات بسيطة. خدمة الإتاحة هي التي تسمح للواحة بإعادة فتح نفسها عندما يكون روتين القفل مستحقًا."
                1 -> "افتح إعدادات التطبيق، ومن قائمة الإعدادات المقيدة اسمح للتطبيق باستخدام صلاحيات الإتاحة إذا ظهر هذا الخيار."
                2 -> "الآن فعّل خدمة «خدمة قفل الواحة للروتينات» من إعدادات إمكانية الوصول."
                else -> "اسمح بالإشعارات والموقع حتى تعمل التنبيهات ومواقيت الصلاة."
            },
            textAlign = TextAlign.Center
        )
        Spacer(Modifier.height(24.dp))
        when (step) {
            0 -> Button(onClick = { step = 1 }) { Text("ابدأ الإعداد") }
            1 -> Button(onClick = {
                context.startActivity(Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply {
                    data = android.net.Uri.parse("package:${context.packageName}")
                })
                step = 2
            }) { Text("فتح إعدادات التطبيق") }
            2 -> Button(onClick = {
                context.startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
                step = 3
            }) { Text("فتح إمكانية الوصول") }
            else -> {
                Button(onClick = {
                    if (Build.VERSION.SDK_INT >= 33 &&
                        ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
                    ) notificationLauncher.launch(Manifest.permission.POST_NOTIFICATIONS)
                    if (ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_COARSE_LOCATION) != PackageManager.PERMISSION_GRANTED)
                        locationLauncher.launch(Manifest.permission.ACCESS_COARSE_LOCATION)
                    AlarmScheduler.scheduleAll(context)
                    onFinished()
                }) { Text("السماح والمتابعة") }
                Spacer(Modifier.height(8.dp))
                TextButton(onClick = onFinished) { Text("تخطي الآن") }
            }
        }
        Spacer(Modifier.height(20.dp))
        Text("الخطوة ${step + 1} من 4", color = LightPalette.muted)
    }
}

@Composable
fun LibraryScreen(onBack: () -> Unit, onOpen: (Routine) -> Unit) {
    val context = LocalContext.current
    var refresh by remember { mutableIntStateOf(0) }
    val routines = remember(refresh) { Store.routines(context) }
    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("مكتبة الروتينات") },
                navigationIcon = { IconButton(onClick = onBack) { Icon(Icons.Default.ArrowBack, null) } },
                actions = { IconButton(onClick = { /* create below */ }) { Icon(Icons.Default.Add, null) } }
            )
        }
    ) { pad ->
        Column(Modifier.fillMaxSize().padding(pad)) {
            TextButton(
                onClick = { onOpen(routines.firstOrNull() ?: defaultRoutines().first()) },
                modifier = Modifier.padding(horizontal = 16.dp)
            ) { Text("ابدأ بروتين جاهز") }
            LazyColumn(
                Modifier.fillMaxSize().padding(horizontal = 16.dp),
                verticalArrangement = Arrangement.spacedBy(10.dp)
            ) {
                items(routines, key = { it.id }) { r ->
