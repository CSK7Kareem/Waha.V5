@Composable
fun SevenDayChart(log: List<LogEntry>) {
    val cal = Calendar.getInstance()
    val keys = (0..6).map {
        val c = cal.clone() as Calendar
        c.add(Calendar.DAY_OF_YEAR, -6 + it)
        SimpleDateFormat("yyyy-MM-dd", Locale.US).format(c.time)
    }
    val counts = keys.map { k -> log.count { it.date == k } }
    val maxValue = max(1, counts.maxOrNull() ?: 1)
    Card {
        Row(
            Modifier.fillMaxWidth().height(160.dp).padding(12.dp),
            horizontalArrangement = Arrangement.SpaceEvenly,
            verticalAlignment = Alignment.Bottom
        ) {
            counts.forEachIndexed { index, count ->
                Column(horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.Bottom) {
                    Box(
                        Modifier.width(24.dp).height((100f * count / maxValue).dp.coerceAtLeast(4.dp))
                            .clip(RoundedCornerShape(8.dp)).background(Color(0xFF168A87))
                    )
                    Text(keys[index].takeLast(2), fontSize = 10.sp)
                }
            }
        }
    }
}

@Composable
fun StatCard(title: String, value: String) {
    Card {
        Row(Modifier.fillMaxWidth().padding(16.dp), horizontalArrangement = Arrangement.SpaceBetween) {
            Text(title)
            Text(value, fontWeight = FontWeight.Bold)
        }
    }
}

fun longestStreak(log: List<LogEntry>): Int {
    if (log.isEmpty()) return 0
    val dates = log.map { it.date }.toSet().sorted()
    var best = 1
    var run = 1
    for (i in 1 until dates.size) {
        val a = SimpleDateFormat("yyyy-MM-dd", Locale.US).parse(dates[i - 1]) ?: continue
        val b = SimpleDateFormat("yyyy-MM-dd", Locale.US).parse(dates[i]) ?: continue
        if ((b.time - a.time) <= 26 * 60 * 60 * 1000L) run++ else run = 1
        best = max(best, run)
    }
    return best
}

