fun nightSlot(): String = "night"

fun anySlot(): String = "any"

fun defaultMorningAlarm(): Pair<Int, Int> = 7 to 0

fun defaultNightAlarm(): Pair<Int, Int> = 22 to 0

fun defaultMorningWindow(): Pair<Int, Int> = 6 * 60 to 12 * 60

fun defaultNightWindow(): Pair<Int, Int> = 21 * 60 to 6 * 60

fun xpPerCompletion(): Int = 25

fun emergencyPenalty(): Int = 50

fun emergencyDurationMs(): Long = 10 * 60 * 1000L

fun oathDurationMs(): Long = 2500L

fun notificationChannelId(): String = CHANNEL

fun serviceLabel(): String = "خدمة قفل الواحة للروتينات"

fun serviceDescription(): String = "تراقب التطبيق المفتوح وتعيدك إلى الواحة عندما يكون روتين مستحقًا."

fun isSystemPackage(pkg: String): Boolean = pkg.startsWith("com.android.systemui")

fun isKeyboardPackage(pkg: String): Boolean =
    pkg.contains("inputmethod") || pkg.contains("keyboard")

fun isInstallerPackage(pkg: String): Boolean =
    pkg.contains("installer") || pkg == "com.google.android.packageinstaller"

fun isPermissionPackage(pkg: String): Boolean =
    pkg == "com.android.permissioncontroller"

fun isTelephonyPackage(pkg: String): Boolean =
    pkg.contains("dialer") || pkg.contains("telecom") || pkg.contains("emergency")

fun isAllowedPackage(context: Context, pkg: String): Boolean =
    pkg == context.packageName ||
        isSystemPackage(pkg) ||
        isKeyboardPackage(pkg) ||
        isInstallerPackage(pkg) ||
        isPermissionPackage(pkg) ||
        isTelephonyPackage(pkg)

fun shouldRedirect(context: Context, pkg: String): Boolean =
    !isAllowedPackage(context, pkg) && shouldShowLock(context)

fun redirectIntent(context: Context, routine: Routine): Intent =
    Intent(context, MainActivity::class.java).apply {
        flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP
        putExtra("locked", true)
        putExtra("routineId", routine.id)
    }

fun currentDueLock(context: Context): Routine? =
    if (shouldShowLock(context)) dueLockedRoutine(context) else null

fun resetEmergency(context: Context) {
    Store.setEmergencyUntil(context, 0)
}

fun resetProgress(context: Context) {
    Store.reset(context)
    AlarmScheduler.scheduleAll(context)
}

fun scheduleAfterReset(context: Context) {
    AlarmScheduler.scheduleAll(context)
}

fun hasRoutines(context: Context): Boolean = Store.routines(context).isNotEmpty()

fun hasLogs(context: Context): Boolean = Store.log(context).isNotEmpty()

fun hasXp(context: Context): Boolean = Store.xp(context) > 0

fun isFirstAchievement(context: Context): Boolean = Store.log(context).size == 1

fun isSevenDayStreak(context: Context): Boolean = streakNow(context) >= 7

fun isThirtyDayStreak(context: Context): Boolean = streakNow(context) >= 30

fun isHundredAchievements(context: Context): Boolean = Store.log(context).size >= 100

fun isThreeHundredXp(context: Context): Boolean = Store.xp(context) >= 300

fun isSultan(context: Context): Boolean = Store.xp(context) >= 1500

fun unlockedBadgeLabels(context: Context): List<String> = badges(context)

fun rankLabel(context: Context): String = rankForXp(Store.xp(context))

fun progressLabel(context: Context): String =
    "${Store.xp(context)} / ${nextRankXp(Store.xp(context))} XP"

fun achievementShareText(context: Context): String =
    "في الواحة وصلت إلى رتبة ${rankLabel(context)}، لدي ${Store.xp(context)} XP وسلسلة ${streakNow(context)} يومًا. 🌴"

fun buildNotificationText(slot: String): String =
    if (slot == "morning") morningMessage() else nightMessage()

fun buildNotificationTitle(slot: String): String =
    if (slot == "morning") "صباح الواحة 🌅" else "ليلة الواحة 🌙"

fun routineMatchesDay(r: Routine, day: Int): Boolean =
    r.days.isEmpty() || r.days.contains(day)

fun routineMatchesSlot(r: Routine, slot: String): Boolean =
    r.slot == "any" || r.slot == slot

fun isTodayDone(context: Context, r: Routine): Boolean =
    Store.isDoneToday(context, r.id)

fun routineDuration(r: Routine): Int = r.steps.sumOf { it.seconds }

fun routineStepCount(r: Routine): Int = r.steps.size

fun routineHasOath(r: Routine): Boolean = r.oath

fun routineLocks(r: Routine): Boolean = r.locks

fun routineTimerMandatory(r: Routine): Boolean = r.mandatoryTimer

fun copyWithName(r: Routine, name: String): Routine =
    r.copy(id = buildRoutineId(), name = safeRoutineName(name))

fun copyWithEmoji(r: Routine, emoji: String): Routine =
    r.copy(id = buildRoutineId(), emoji = safeEmoji(emoji))

fun copyWithSlot(r: Routine, slot: String): Routine =
    r.copy(id = buildRoutineId(), slot = slot)

fun copyWithDays(r: Routine, days: Set<Int>): Routine =
    r.copy(id = buildRoutineId(), days = days)

fun copyWithSteps(r: Routine, steps: List<Step>): Routine =
    r.copy(id = buildRoutineId(), steps = steps)

fun copyWithOath(r: Routine, oath: Boolean): Routine =
    r.copy(id = buildRoutineId(), oath = oath)

fun copyWithTimer(r: Routine, timer: Boolean): Routine =
    r.copy(id = buildRoutineId(), mandatoryTimer = timer)

fun copyWithLock(r: Routine, locks: Boolean): Routine =
    r.copy(id = buildRoutineId(), locks = locks)

fun stepValid(s: Step): Boolean = s.text.isNotBlank() && s.seconds in 0..3600

fun stepsValid(steps: List<Step>): Boolean =
    steps.isNotEmpty() && steps.all(::stepValid)

fun daysValid(days: Set<Int>): Boolean =
    days.isNotEmpty() && days.all { it in 1..7 }

fun routineValid(r: Routine): Boolean =
    validateRoutine(r) && daysValid(r.days) && stepsValid(r.steps)

fun formatStep(s: Step): String =
    if (s.seconds > 0) "${s.text} — ${s.seconds} ثانية" else s.text

fun formatRoutine(r: Routine): String =
    "${r.emoji} ${r.name}\n${r.steps.joinToString("\n") { "• ${formatStep(it)}" }}"

fun notificationPendingIntent(context: Context, slot: String): PendingIntent =
    PendingIntent.getActivity(
        context,
        notificationId(slot),
        Intent(context, MainActivity::class.java).apply {
            flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP
        },
        PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
    )

fun alarmPendingIntent(context: Context, slot: String): PendingIntent =
    PendingIntent.getBroadcast(
        context,
        if (slot == "morning") MORNING_REQ else NIGHT_REQ,
        Intent(context, AlarmReceiver::class.java).putExtra(EXTRA_SLOT, slot),
        PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
    )

fun notificationChannelName(): String = "تنبيهات الواحة"

fun notificationChannelDescription(): String = "تذكيرات روتينات الصباح والليل"

fun permissionIntent(context: Context): Intent =
    Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply {
        data = android.net.Uri.parse("package:${context.packageName}")
    }

fun exactAlarmIntent(context: Context): Intent? =
    if (Build.VERSION.SDK_INT >= 31) Intent(Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM).apply {
        data = android.net.Uri.parse("package:${context.packageName}")
    } else null

fun notificationIntent(context: Context): Intent =
    Intent(Settings.ACTION_APP_NOTIFICATION_SETTINGS).apply {
        putExtra(Settings.EXTRA_APP_PACKAGE, context.packageName)
    }

fun accessibilityIntent(): Intent =
    Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)

fun nowMs(): Long = System.currentTimeMillis()

fun tenMinutesFromNow(): Long = nowMs() + emergencyDurationMs()

fun oathMs(): Long = oathDurationMs()

fun appPackage(context: Context): String = context.packageName

fun isDebugBuild(): Boolean = true

fun userFacingBuildLabel(): String = if (isDebugBuild()) "نسخة تجريبية" else "نسخة مستقرة"

fun supportText(): String =
    "إذا لم يعمل القفل، تأكد من تفعيل خدمة الإتاحة والسماح للتطبيق بالعمل في الخلفية."

